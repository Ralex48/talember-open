{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talember-open",
  "main": "./app/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "TALEMBER_RENDERER",
      "service": "talember-greeting-renderer"
    }
  ],
  "dependencies_instrumentation": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "TALEMBER_DB",
      "database_name": "talember-open-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "TALEMBER_PRIVATE_MEDIA",
      "bucket_name": "talember-open-private-media",
      "remote": false
    }
  ],
  "vars": {
    "TALEMBER_SUPPORT_URL": "mailto:support@example.com",
    "TALEMBER_BUSINESS_NAME": "Your business name",
    "TALEMBER_CREATION_ENABLED": "false",
    "TALEMBER_PUBLIC_ORIGIN": "https://example.com",
    "OPENROUTER_DIRECTOR_MODEL": "openai/gpt-5.6-sol",
    "TALEMBER_PAYMENT_ENVIRONMENT": "sandbox"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
