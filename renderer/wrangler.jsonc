{
  "name": "talember-greeting-renderer",
  "main": "worker.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{ "class_name": "GreetingRenderer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic" }],
  "durable_objects": { "bindings": [{ "name": "RENDERER", "class_name": "GreetingRenderer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GreetingRenderer"] }],
  "observability": { "enabled": false }
}
